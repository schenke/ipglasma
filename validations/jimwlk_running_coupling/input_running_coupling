# Input template of the JIMWLK running-coupling validation, run by
# running_coupling.py, which overrides size, L, Ny, g2muGeV, seed, the
# Bjorken x values and the JIMWLK coupling parameters for each run.
#
# The MV model with a constant color-charge density (useNucleus 0) as the
# initial condition of JIMWLK; only the Wilson lines of the two nuclei
# (two independent configurations) are built and evolved (runEvolution 0),
# and written in binary (writeWilsonLines 2) at the snapshot x values. The
# nucleus and hot-spot parameters are required but not used with
# useNucleus 0.
runEvolution 0
size 1024
L 5.92
Ny 100
g 1
maxTime 0.5
timeStepsPerLatticeSpacing 10
inverseQsForMaxTime 0
seed 1
useSeedList 0
projectile Pb
target Pb
sigmaNN 73
useNucleus 0
readInitialWilsonLines 0
g2muGeV 1
useSmoothNucleus 0
nucleiToAverage 1
nucleonPositionsFromFile 0
polarizationProjectile 0
polarizationTarget 0
useInputWSParams 0
forceDMin 0
dMin 0.9
nucleonModel hotspots
subNucleonParamType 0
m 0
BG 3.3
BGq 0.3
BGqVar 0
dqMin 0
omega 1
Nq 3
NqFluc 0
shiftConstituentQuarkProtonOrigin 1
QsMuRatio 0.643
smearQs 0
UVDamp 0
minimumQs2ST 0
nucleusQsTableFileName qs2Adj_vs_Tp_vs_Y_240.in
rapidity 0
usePseudoRapidity 0
useFluctuatingX 0
projectileX 1e-04
targetX 1e-04
runningCoupling 0
nFlavors 3
computeGluonMultiplicity 0
computeEccentricities 0
writeHydro 0
writeJazma 0
writeTmunu 0
writeWilsonLineSnapshot 0
writeNpartList 0
writeNcollList 0
writeNgluonEstimators 0
writeOutputsToHDF5 0
writeWilsonLines 2
writeWilsonLineGeometry 0
wilsonLinePath ./
useJIMWLK 1
jimwlkMu0 0.5
jimwlkLambdaQCD 0.2
jimwlkC 0.2
jimwlkMass 0
jimwlkAlphaS 0
jimwlkRunningCoupling 2
jimwlkDs 0.005
jimwlkInitialX 0.01
jimwlkSaveSnapshots 1
jimwlkXSnapshotList 1e-3
